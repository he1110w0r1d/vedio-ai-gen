PORT=8787
NODE_ENV=development
APP_ENCRYPTION_KEY=replace-with-32-byte-secret-value
CORS_ORIGIN=http://127.0.0.1:5173

# ---- 访问控制（可选，默认关闭）----
APP_ACCESS_CONTROL=off
APP_BASIC_AUTH_USERNAME=admin
# APP_BASIC_AUTH_PASSWORD_HASH=scrypt:...:...
# APP_BASIC_AUTH_HEALTH_PUBLIC=true  # 默认 true：/health 公开；false：也需认证

# ---- 数据存储后端 ----
# json（默认）| sqlite（推荐预发）
DATA_BACKEND=json
# SQLITE_DB_PATH=server/data/app.sqlite
